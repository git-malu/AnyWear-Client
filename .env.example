# AWS E2E Testing Configuration
# Used by Playwright for authentication bypass tests
AWS_REGION=us-east-1
USER_POOL_ID=your_cognito_user_pool_id
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Frontend Vite Configuration 
# Required for the React app to communicate with Cognito during tests
VITE_COGNITO_USER_POOL_ID=your_cognito_user_pool_id
VITE_COGNITO_CLIENT_ID=your_cognito_client_id
VITE_COGNITO_IDENTITY_POOL_ID=your_cognito_identity_pool_id
